# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/argon_db"

# S3-Compatible Storage (Cloudflare R2 recommended — free tier, S3-compatible)
# Sign up at https://dash.cloudflare.com → R2 Object Storage → Create bucket
S3_BUCKET_NAME=argon-images
S3_REGION=auto
S3_ENDPOINT=https://832cb79a7d5ea498ed5d6af06efae0ce.r2.cloudflarestorage.com/argon-images
S3_ACCESS_KEY_ID=e0a4ad9b9ab25dd9b38865f3facef525
S3_SECRET_ACCESS_KEY=6feceebbcb5084fe15563c1f690e334d9bd4f6fdfc93d7e9fad4d70e00a78e6a
S3_PUBLIC_URL=https://pub-<HASH>.r2.dev   # optional: public bucket URL

# Alternatively for real AWS S3:
# S3_REGION=us-east-1
# S3_ENDPOINT=   (leave blank for AWS)
