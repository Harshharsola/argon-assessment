generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Image {
  id               String   @id @default(uuid())
  originalName     String
  storedKey        String?  // S3/R2 object key (null for rejected images)
  url              String?  // public URL (null for rejected images)
  mimeType         String
  sizeBytes        Int
  widthPx          Int?
  heightPx         Int?
  status           ImageStatus @default(PROCESSING)
  rejectionReason  String?
  pHash            String?     // 64-bit perceptual hash for similarity detection
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([pHash])
}

enum ImageStatus {
  PROCESSING
  ACCEPTED
  REJECTED
}
